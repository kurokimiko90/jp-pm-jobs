# 環境變數範本 — 複製為 .env 後填寫（.env 不會被 git 追蹤）
# ─────────────────────────────────────────────────────────

# ── LLM Provider（依 config/llm.yaml 的 chain 選用其一或多個）──
# 方式 A：API key（推薦，最穩定）
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# 方式 B：本機 CLI（吃訂閱制額度，免 API key）
# 只需先在本機安裝並登入 claude / codex / gemini CLI 其中之一，
# 若不在 PATH 上可指定絕對路徑：
# CLAUDE_PATH=/opt/homebrew/bin/claude
# CODEX_PATH=/opt/homebrew/bin/codex
# GEMINI_PATH=/opt/homebrew/bin/gemini

# 覆蓋 LLM 設定檔路徑（預設 config/llm.yaml）
# LLM_CONFIG=config/llm.yaml

# ── Dashboard 後端 ──
# CORS 允許來源，逗號分隔（預設僅本機 vite dev server）
DASHBOARD_CORS_ORIGINS=http://localhost:5173
# 服務埠（預設 8000）
DASHBOARD_PORT=8000
# 設定後啟用單一使用者登入保護（留空 = 不驗證，僅本機使用時可接受）
DASHBOARD_PASSWORD=

# ── Telegram 通知 / 互動 bot（可選功能）──
# 通知（notify 模組）與手機互動 bot（notify/bot.py）共用。
# 1. @BotFather 建 bot 拿 token；2. 給 bot 發一句話後開
#    https://api.telegram.org/bot<TOKEN>/getUpdates 找 chat.id
# 留空 = 通知降級為 stdout，bot 不啟動。此檔案永不進 git。
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── AI 職涯助手專用 bot（可選功能，獨立於上面的通知 bot）──
# 自由文字問答會跟通知卡片混在同個聊天室不好回溯，故另建一個 bot：
# 1. @BotFather 再建一個新 bot 拿 token（跟上面的 TELEGRAM_BOT_TOKEN 不要共用）
# 2. 給新 bot 發一句話後開 https://api.telegram.org/bot<TOKEN>/getUpdates 找 chat.id
# 留空 = assistant/bot.py 不啟動，Web Dashboard 的職涯助手頁面仍可正常使用。
ASSISTANT_TELEGRAM_BOT_TOKEN=
ASSISTANT_TELEGRAM_CHAT_ID=

# ── Gmail（inbox / recruiter_agent，可選功能）──
# 需先跑 `python3 -m inbox.auth` 完成 OAuth，本變數非必填
# GOOGLE_API_KEY=
